      DearBindings.Qualifier
      DearBindings.Slice
  other-modules:
      Paths_dear_bindings_aeson
  autogen-modules:
      Paths_dear_bindings_aeson
  hs-source-dirs:
      src
  default-extensions:
      BlockArguments
      DuplicateRecordFields
      LambdaCase
      NoFieldSelectors
      OverloadedRecordDot
      OverloadedStrings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      aeson >=2.2
    , base >=4.7 && <5
    , bytestring
    , containers
    , text
  default-language: GHC2021

